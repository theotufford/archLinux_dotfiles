{
        "layer": "top",
        "modules-left": [
                "sway/mode"
        ],
        "modules-center": [
                "hyprland/workspaces"
        ],
        "modules-right": [
                "battery",
                "clock"
        ],
        "hyprland/workspaces": {
                "format": "{icon}",
                "on-click": "activate",
                "persistent-workspaces": {
                        "*": [ 1,2,3,4 ]
                },
                "format-icons": {
                        "4":"",
                        "3":"",
                        "2":"󰈹",
                        "1":"",
                },
                "all-outputs": false, // Show all workspaces on every bar
                "sort-by": "id"
        },
        "battery": {
                "format": "{capacity}% {icon}",
                "format-icons": [
                        "",
                        "",
                        "",
                        "",
                        ""
                ]
        },
        "clock": {
                "format-alt": "{:%a, %d. %b  %H:%M}"
        }
}
