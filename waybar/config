{
        "layer": "top",
        "modules-left": [
                "sway/mode"
        ],
        "modules-center": [
                "hyprland/workspaces"
        ],
        "modules-right": [
                "battery",
                "clock"
        ],
        "hyprland/workspaces": {
                "format": "{icon}",
                "on-click": "activate",
                // Optional: show a specific number of persistent workspaces
                "persistent-workspaces": {
                        "*": 4 // e.g., 4 workspaces on all monitors
                },
                "format-icons": {
                        "active": "◉",
                        "default": "ⵔ",
                        "urgent": "!",
                        "focused": "●"
                },
                "all-outputs": true, // Show all workspaces on every bar
                "sort-by": "number"
        },
        "battery": {
                "format": "{capacity}% {icon}",
                "format-icons": [
                        "",
                        "",
                        "",
                        "",
                        ""
                ]
        },
        "clock": {
                "format-alt": "{:%a, %d. %b  %H:%M}"
        }
}
